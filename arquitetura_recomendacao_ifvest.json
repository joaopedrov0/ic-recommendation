    },
    {
      "id": "ifvest-backend-api",
      "kind": "server",
      "name": "IFVest Backend API",
      "description": "Servidor principal da API REST. Expõe rotas de Quiz, Simulados e Recomendações protegidas por Feature Flags e injeta o AdaptiveQuestionChooser.",
      "technology": "FastAPI / Python 3.12",
      "tags": [
        "FastAPI",
        "SQLAlchemy Async",
        "Pydantic v2"
      ],
      "layout": {
        "x": 85.74119224685847,
        "y": 61.32216631559516
      },
      "details": {
        "routes": [
          {
            "id": "rt_pop",
            "method": "GET",
            "path": "/api/v1/recommendations/questions/popular",
            "description": "Retorna questões em alta (Time Decay) ou mais desafiadoras (Estimador Bayesiano)."
          },
          {
            "id": "rt_ibcf",
            "method": "GET",
            "path": "/api/v1/recommendations/questions/for-me",
            "description": "Recomenda Top-N questões personalizadas via IBCF calibradas na Zona de Desenvolvimento Proximal (~85% acerto esperado)."
          },
          {
            "id": "rt_quiz_next",
            "method": "GET",
            "path": "/api/v1/quiz/current-question",
            "description": "Sorteia ou seleciona a próxima questão do quiz usando AdaptiveQuestionChooser."
          },
          {
            "id": "rt_quiz_ans",
            "method": "POST",
            "path": "/api/v1/quiz/answer",
            "description": "Valida resposta da questão no quiz e grava response_time_ms e used_hint."
          },
          {
            "id": "rt_mock_rec",
            "method": "POST",
            "path": "/api/v1/mocktests/recommended",
            "description": "Gera simulado personalizado combinando IBCF, Popularidade Bayesiana e diversidade de tópicos."
          }
        ],
        "env": [
          {
            "key": "FEATURE_MODULE_RECOMMENDATIONS",
            "value": "true",
            "description": "Feature flag do módulo de recomendação"
          },
          {
            "key": "REC_MIN_SUPPORT_THRESHOLD",
            "value": "5",
            "description": "Suporte mínimo para estimador bayesiano (m) e IBCF (gamma)"
          }
        ],
        "notes": "Injeta QuestionChooser (Protocol) em get_current_quiz_question sem acoplar a rota ao algoritmo."
      }
    },
    {
      "id": "motor-popularidade-ibcf",
      "kind": "worker",
      "name": "Motor Popularidade & IBCF",
      "description": "Serviço/Worker assíncrono que consolida interações (Quiz + Simulados), calcula Popularidade Bayesiana + Time Decay, calibra dificuldade empírica (1-5) e constrói a matriz esparsa Item-Item do IBCF.",
      "technology": "Python Async Service / Cron",
      "tags": [
        "Popularity",
        "IBCF",
        "Adjusted Cosine",
        "ZPD 85%"
      ],
      "layout": {
        "x": 614.1909437171104,
        "y": 214.05369148870616,
        "expanded": true
      },
      "details": {
        "topics": [
          {
            "id": "tp_pop_job",
            "name": "popularity_recommender: Estimador Bayesiano + Time Decay + Calibração de Dificuldade (1-5)"
          },
          {
            "id": "tp_ibcf_job",
            "name": "ibcf_recommender: Similaridade de Cosseno Ajustada + Top-K Vizinhos + Filtro ZDP"
          }
        ],
        "notes": "Executa em background ou sob demanda com complexidade O(|I|^2) restrita a pares com co-ocorrência >= 2. Aplica k-anonimato (gamma >= 5) na matriz de similaridade."
      }
    },
    {
      "id": "cache-de-similaridade-e-ranking",
      "kind": "cache",
      "name": "Cache de Similaridade e Ranking",
      "description": "Armazenamento rápido dos vetores Top-K de vizinhança de itens e scores de popularidade para baixa latência (< 5ms) durante sessões de Quiz.",
      "technology": "In-Memory / Redis Cache",
      "tags": [
